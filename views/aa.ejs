<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Approving Authority Portal - Auto Competency Portal</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/png" href="/images/ir.png">
</head>

<body>
  <header>
    <div class="brand">
      <img src="/images/ir.png" alt="Logo" onerror="this.src='/images/ir.png'">
      <h1>Railway Competency System</h1>
    </div>
    <div class="nav-user">
      <div class="user-tag" style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.15rem; background: none; border: none; padding: 0;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span class="user-name-text" style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);"><%= user.name %></span>
          <span class="role-badge" style="background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%); color: white; font-weight: 800; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.7rem; letter-spacing: 0.5px; border: none; box-shadow: 0 2px 8px rgba(234, 92, 12, 0.2); text-transform: uppercase;"><%= user.user_type %></span>
        </div>
        <span style="font-size: 0.78rem; color: var(--text-secondary); font-weight: 500;"><%= user.designation %></span>
      </div>
      <a href="/logout" class="btn-logout">Logout</a>
    </div>
  </header>

  <main>
    <div class="page-heading"
      style="display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 250px;">
        <h2 style="margin: 0 0 0.25rem 0;">Approving Authority Dashboard</h2>
        <p style="margin: 0; color: var(--text-secondary); font-size: 0.95rem;">Evaluate pending training completions,
          grant competency certificates, and sign digital credentials.</p>
      </div>
      <div style="flex-shrink: 0;">
        <div class="goal-badge">
          <span class="goal-number">
            <%= historyCertificates.filter(h=> h.status === 'APPROVED').length %>
          </span>
          <span class="goal-label">Certified</span>
        </div>
      </div>
    </div>

    <!-- Alert Notifications -->
    <div id="alerts-container"></div>

    <!-- Pending Recommendations -->
    <div class="card">
      <div class="card-title"
        style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <span>Pending Approvals</span>
          <span id="pending-live-indicator" title="Auto-updating every 15 seconds"
            style="display:inline-flex;align-items:center;gap:0.3rem;font-size:0.72rem;font-weight:600;
                   color:#34d399;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);
                   border-radius:20px;padding:0.15rem 0.6rem;">
            <span style="width:7px;height:7px;border-radius:50%;background:#34d399;
                         animation:livePulse 2s ease-in-out infinite;display:inline-block;"></span>
            LIVE
          </span>
        </div>
        <button id="btn-bulk-approve" class="btn btn-success"
          style="padding: 0.5rem 1rem; font-size: 0.85rem; display: none;">
          Grant/Approve Selected (<span id="bulk-select-count">0</span>)
        </button>
      </div>
      <% if (pendingCertificates.length===0) { %>
        <div
          style="text-align: center; padding: 2rem; border-radius: 12px; font-weight: 500; font-size: 1rem; border: 1px solid rgba(16, 185, 129, 0.25); background: rgba(16, 185, 129, 0.08); color: #34d399; display: flex; align-items: center; justify-content: center; gap: 0.75rem; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.05); margin-top: 0.5rem;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            style="flex-shrink: 0; color: var(--success-color);">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          No pending competency certificate requests found.
        </div>
        <% } else { %>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th style="width: 45px; text-align: center;"><input type="checkbox" id="select-all-pending"
                      style="transform: scale(1.2); cursor: pointer;"></th>
                  <th>CMS ID</th>
                  <th>Name</th>
                  <th>Desig</th>
                  <th>Forwarded By</th>
                  <th>C Date</th>
                  <th>Validity Expiry</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% pendingCertificates.forEach(c=> { %>
                  <tr>
                    <td data-label="Select" style="text-align: center; vertical-align: middle;">
                      <input type="checkbox" value="<%= c.id %>" class="pending-checkbox"
                        style="transform: scale(1.2); cursor: pointer;">
                    </td>
                    <td data-label="CMS ID">
                      <code
                        style="font-size: 0.82rem; color: #60a5fa;"><%= (c.employee_id || '').toUpperCase() %></code>
                    </td>
                    <td data-label="Name" style="font-weight: 600;">
                      <%= c.employee_name %>
                    </td>
                    <td data-label="Desig">
                      <%= c.designation %>
                    </td>
                    <td data-label="Forwarded By">
                      <%= c.forwarded_by_name %> (<code><%= c.forwarded_by %></code>)
                    </td>
                    <td data-label="C Date">
                      <%= formatIST(c.certified_date) %>
                    </td>
                    <td data-label="Validity Expiry">
                      <%= formatIST(c.valid_upto) %>
                    </td>
                    <td data-label="Actions">
                      <div class="table-actions">
                        <form action="/aa/certificates/approve/<%= c.id %>" method="POST" style="margin: 0;">
                          <button type="submit" class="btn btn-success"
                            style="padding: 0.4rem 0.8rem; font-size: 0.8rem;">
                            Grant/Approve
                          </button>
                        </form>
                        <form action="/aa/certificates/reject/<%= c.id %>" method="POST" style="margin: 0;">
                          <button type="button" class="btn btn-danger"
                            data-id="<%= c.id %>"
                            onclick="rejectCert(this.dataset.id, '/aa/certificates/reject/' + this.dataset.id)"
                            style="padding: 0.4rem 0.8rem; font-size: 0.8rem; background: transparent; border: 1px solid rgba(239, 68, 68, 0.4); color: var(--danger-color);">
                            Reject
                          </button>
                         </form>
                       </div>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
          <!-- Hidden action form for reject/delete — outside table to avoid nesting issues -->
          <form id="aa-action-form" action="" method="POST" style="display:none;"></form>
    </div>

    <div class="card">
      <div class="card-title">
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span>Processed Certificates History</span>
          <!-- Live indicator -->
          <span id="live-indicator" title="Auto-updating every 15 seconds"
            style="display:inline-flex;align-items:center;gap:0.3rem;font-size:0.72rem;font-weight:600;
                   color:#34d399;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.25);
                   border-radius:20px;padding:0.15rem 0.6rem;">
            <span style="width:7px;height:7px;border-radius:50%;background:#34d399;
                         animation:livePulse 2s ease-in-out infinite;display:inline-block;"></span>
            LIVE
          </span>
        </div>
        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
          <button type="submit" form="print-batch-form" class="btn btn-secondary" title="Print selected certificates">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            Print <span class="hide-mobile">Selected</span>
          </button>
          <button type="button" onclick="downloadSelectedBatch()" class="btn btn-success" title="Download selected as PDF" style="gap: 0.4rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="hide-mobile">Download</span> PDF
          </button>
          <button type="button" id="download-approved-btn" data-certs="<%- JSON.stringify(historyCertificates.filter(h => h.status === 'APPROVED')).replace(/"/g, '&quot;') %>" onclick="downloadApprovedCSV()" class="btn btn-primary"
            title="Download all approved certificates as CSV" style="gap: 0.4rem; background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); box-shadow: 0 4px 12px rgba(99,102,241,0.3);">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="hide-mobile">Approved</span> CSV
          </button>
        </div>
      </div>
      <!-- Search & Filter Controls -->
      <div class="filters-bar"
        style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.25rem; background: rgba(255,255,255,0.02); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color); align-items: flex-end;">
        <div style="flex: 1.5; min-width: 200px;">
          <label for="filter-name"
            style="display: block; font-size: 0.8rem; font-weight: 500; margin-bottom: 0.4rem; color: var(--text-secondary);">Filter
            by Employee Name</label>
          <input type="text" id="filter-name" class="form-control" placeholder="Type name to search..."
            oninput="applyFilters()" style="padding: 0.5rem 0.75rem; font-size: 0.9rem;">
        </div>
        <div style="flex: 1.2; min-width: 200px;">
          <label for="filter-date-from"
            style="display: block; font-size: 0.8rem; font-weight: 500; margin-bottom: 0.4rem; color: var(--text-secondary);">Certified
            Date (From)</label>
          <input type="date" id="filter-date-from" class="form-control" onchange="applyFilters()"
            style="padding: 0.5rem 0.75rem; font-size: 0.9rem; min-height: 38px;">
        </div>
        <div style="flex: 1; min-width: 150px;">
          <label for="filter-status"
            style="display: block; font-size: 0.8rem; font-weight: 500; margin-bottom: 0.4rem; color: var(--text-secondary);">Filter
            by Status</label>
          <select id="filter-status" class="form-control" onchange="applyFilters()"
            style="padding: 0.5rem 0.75rem; font-size: 0.9rem;">
            <option value="">All Statuses</option>
            <option value="APPROVED">Approved</option>
            <option value="REJECTED">Rejected</option>
          </select>
        </div>
        <div style="min-width: 120px;">
          <button type="button" class="btn btn-secondary" onclick="resetAllFilters()"
            style="padding: 0.5rem 1rem; font-size: 0.9rem; width: 100%; height: 41px;">Reset Filters</button>
        </div>
      </div>

      <div class="table-container">
        <form id="print-batch-form" action="/certificate/print-batch" method="GET" target="_blank" onsubmit="return validatePrintForm(event)">
          <table>
            <thead>
              <tr>
                <th><input type="checkbox" id="selectAll" onclick="toggleAll(this)"></th>
                <th>Cert No</th>
                <th>CMS ID</th>
                <th>Name</th>
                <th>Desig</th>
                <th>C Date</th>
                <th>Status</th>
                <th>Action Taken On</th>
                <th>Link</th>
              </tr>
            </thead>
            <tbody>
              <% if (historyCertificates.length===0) { %>
                <tr>
                  <td colspan="9" style="text-align: center; color: var(--text-secondary); padding: 2rem;">
                    No processed certificate history found.
                  </td>
                </tr>
                <% } else { %>
                  <% historyCertificates.forEach(h=> {
                    const cDate = new Date(h.certified_date);
                    const dataDateStr = `${cDate.getFullYear()}-${String(cDate.getMonth() + 1).padStart(2,
                    '0')}-${String(cDate.getDate()).padStart(2, '0')}`;
                    %>
                    <tr class="cert-row" data-name="<%= h.employee_name.toLowerCase() %>" data-date="<%= dataDateStr %>"
                      data-status="<%= h.status %>">
                      <td data-label="Select">
                        <% if (h.status==='APPROVED' ) { %>
                          <input type="checkbox" name="ids" value="<%= h.id %>" class="cert-checkbox">
                          <% } else { %>
                            <input type="checkbox" disabled>
                            <% } %>
                      </td>
                      <td data-label="CertNo" style="font-family: monospace; font-weight: 600;">
                        <%= h.cert_number ? (h.cert_number.split('/').length>= 6 ?
                          h.cert_number.split('/').slice(-3).join('/') : h.cert_number.split('/').slice(-2).join('/')) :
                          'N/A' %>
                      </td>
                      <td data-label="CMS ID">
                        <code
                          style="font-size: 0.82rem; color: #60a5fa;"><%= (h.employee_id || '').toUpperCase() %></code>
                      </td>
                      <td data-label="Name">
                        <%= h.employee_name %>
                      </td>
                      <td data-label="Desig">
                        <%= h.designation %>
                      </td>
                      <td data-label="C Date">
                        <%= formatIST(h.certified_date) %>
                      </td>
                      <td data-label="Status" style="text-align: center;">
                        <% if (h.status==='APPROVED' ) { %>
                          <span title="Approved" style="display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; background:rgba(34,197,94,0.12); border:1.5px solid rgba(34,197,94,0.45); color:#22c55e; cursor:help;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                              <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                          </span>
                        <% } else { %>
                          <span title="Rejected" style="display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; background:rgba(239,68,68,0.12); border:1.5px solid rgba(239,68,68,0.45); color:#ef4444; cursor:help;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="15" y1="9" x2="9" y2="15"></line>
                              <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                          </span>
                        <% } %>
                      </td>
                      <td data-label="Action Taken On">
                        <%= formatIST(h.approved_at, true) %>
                      </td>
                      <td data-label="Link">
                        <% if (h.status==='APPROVED' ) { %>
                          <div style="display: flex; gap: 0.35rem; align-items: center; flex-wrap: nowrap;">
                            <a href="/certificate/view/<%= h.id %>" target="_blank" class="btn btn-secondary"
                              style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" title="View & Print">
                              View/Print
                            </a>
                            <a href="/certificate/download/<%= h.id %>" target="_blank" class="btn btn-primary"
                              style="padding: 0.25rem 0.5rem; font-size: 0.75rem; gap: 0.2rem;" title="Download PDF">
                              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                              </svg>
                            </a>
                          </div>
                          <% } else { %>
                            <button type="button" data-id="<%= h.id %>" onclick="deleteRejected(this.dataset.id)"
                              style="padding:0.25rem 0.6rem;font-size:0.75rem;display:inline-flex;align-items:center;gap:0.3rem;background:transparent;border:1px solid rgba(239,68,68,0.4);color:#ef4444;border-radius:6px;cursor:pointer;"
                              title="Delete this rejected entry">
                              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v6"></path><path d="M14 11v6"></path>
                                <path d="M9 6V4h6v2"></path>
                              </svg>
                              Delete
                            </button>
                          <% } %>
                      </td>
                    </tr>
                    <% }) %>
                      <% } %>
            </tbody>
          </table>
        </form>
      </div>
    </div>
  </main>

  <!-- Themed Confirmation Modal -->
  <div id="confirm-modal" style="display:none;position:fixed;inset:0;z-index:9999;align-items:center;justify-content:center;">
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.65);backdrop-filter:blur(6px);" onclick="_confirmCancel()"></div>
    <div id="confirm-modal-box" style="position:relative;background:linear-gradient(135deg,rgba(17,24,39,0.98),rgba(30,41,59,0.98));border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:2rem 2rem 1.5rem;max-width:420px;width:90%;box-shadow:0 25px 60px rgba(0,0,0,0.6);animation:modalIn 0.2s cubic-bezier(0.34,1.56,0.64,1);">
      <div style="display:flex;align-items:flex-start;gap:1rem;margin-bottom:1.25rem;">
        <div id="confirm-icon" style="flex-shrink:0;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;"></div>
        <div>
          <div id="confirm-title" style="font-size:1.05rem;font-weight:700;color:var(--text-primary);margin-bottom:0.35rem;"></div>
          <div id="confirm-message" style="font-size:0.88rem;color:var(--text-secondary);line-height:1.5;"></div>
        </div>
      </div>
      <div style="display:flex;gap:0.75rem;justify-content:flex-end;margin-top:1.5rem;">
        <button id="confirm-cancel-btn" onclick="_confirmCancel()"
          style="padding:0.5rem 1.25rem;font-size:0.88rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:var(--text-secondary);border-radius:8px;cursor:pointer;transition:all 0.2s;"
          onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='var(--text-primary)'"
          onmouseout="this.style.background='rgba(255,255,255,0.05)';this.style.color='var(--text-secondary)'">Cancel</button>
        <button id="confirm-ok-btn" onclick="_confirmOk()"
          style="padding:0.5rem 1.25rem;font-size:0.88rem;border:none;border-radius:8px;cursor:pointer;font-weight:600;transition:all 0.2s;"></button>
      </div>
    </div>
  </div>

  <footer class="app-footer">
    Version 1.0 @ copyright 2026 by KOMMARA SURESH
  </footer>

  <script>
    // Professional theme-based alerts handler
    function showAlert(message, type = 'success') {
      const alertsContainer = document.getElementById('alerts-container');
      if (!alertsContainer) return;

      const alertDiv = document.createElement('div');
      alertDiv.className = `alert alert-${type}`;
      alertDiv.style.animation = 'fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1)';

      let iconSvg = '';
      if (type === 'success') {
        iconSvg = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: #34d399; flex-shrink: 0;">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        `;
      } else {
        iconSvg = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: #f87171; flex-shrink: 0;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        `;
      }

      alertDiv.innerHTML = `
        ${iconSvg}
        <span style="flex: 1;">${message}</span>
        <button type="button" onclick="this.parentElement.remove()" style="background: transparent; border: none; color: var(--text-secondary); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0.25rem; margin-left: auto; transition: color 0.2s;" onmouseover="this.style.color='var(--text-primary)'" onmouseout="this.style.color='var(--text-secondary)'">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      `;

      alertsContainer.innerHTML = '';
      alertsContainer.appendChild(alertDiv);

      // Auto-dismiss after 6 seconds
      setTimeout(() => {
        if (alertDiv && alertDiv.parentElement) {
          alertDiv.style.opacity = '0';
          alertDiv.style.transform = 'translateY(-10px)';
          alertDiv.style.transition = 'all 0.4s ease-out';
          setTimeout(() => {
            if (alertDiv.parentElement) alertDiv.remove();
          }, 400);
        }
      }, 6000);
    }

    // Handle initial alerts from query parameters
    const params = new URLSearchParams(window.location.search);
    const successMsg = params.get('success');
    const errorMsg = params.get('error');
    if (successMsg) {
      showAlert(successMsg, 'success');
      window.history.replaceState({}, document.title, window.location.pathname);
    }
    if (errorMsg) {
      showAlert(errorMsg, 'danger');
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    // ============================================================
    // Themed confirmation modal — replaces native browser confirm()
    // ============================================================
    let _confirmCallback = null;

    function showConfirm(message, onConfirm, { title = 'Confirm Action', type = 'danger', okLabel, hideCancel = false } = {}) {
      _confirmCallback = onConfirm;
      document.getElementById('confirm-title').textContent = title;
      document.getElementById('confirm-message').textContent = message;

      const iconEl = document.getElementById('confirm-icon');
      const okBtn  = document.getElementById('confirm-ok-btn');
      const cancelBtn = document.getElementById('confirm-cancel-btn');

      if (cancelBtn) {
        cancelBtn.style.display = hideCancel ? 'none' : 'inline-block';
      }

      if (type === 'danger') {
        iconEl.style.background = 'rgba(239,68,68,0.15)';
        iconEl.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
        okBtn.style.cssText = 'padding:0.5rem 1.25rem;font-size:0.88rem;background:linear-gradient(135deg,#ef4444,#dc2626);border:none;border-radius:8px;cursor:pointer;font-weight:600;color:#fff;';
        okBtn.textContent = okLabel || 'Confirm';
      } else if (type === 'warning') {
        iconEl.style.background = 'rgba(251,146,60,0.15)';
        iconEl.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`;
        okBtn.style.cssText = 'padding:0.5rem 1.25rem;font-size:0.88rem;background:linear-gradient(135deg,#fb923c,#ea580c);border:none;border-radius:8px;cursor:pointer;font-weight:600;color:#fff;';
        okBtn.textContent = okLabel || 'Confirm';
      } else {
        iconEl.style.background = 'rgba(34,197,94,0.15)';
        iconEl.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`;
        okBtn.style.cssText = 'padding:0.5rem 1.25rem;font-size:0.88rem;background:linear-gradient(135deg,#22c55e,#16a34a);border:none;border-radius:8px;cursor:pointer;font-weight:600;color:#fff;';
        okBtn.textContent = okLabel || 'Confirm';
      }

      document.getElementById('confirm-modal').style.display = 'flex';
      okBtn.focus();
    }

    function _confirmOk() {
      document.getElementById('confirm-modal').style.display = 'none';
      if (typeof _confirmCallback === 'function') _confirmCallback();
      _confirmCallback = null;
    }

    function _confirmCancel() {
      document.getElementById('confirm-modal').style.display = 'none';
      _confirmCallback = null;
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') _confirmCancel(); });

    // Reject certificate (from pending row) — themed confirm
    function rejectCert(certId, formAction) {
      showConfirm(
        'This will mark the certificate request as Rejected. The FA will be notified.',
        () => {
          const f = document.getElementById('aa-action-form');
          f.action = formAction;
          f.submit();
        },
        { title: 'Reject Certificate Request?', type: 'danger', okLabel: 'Reject' }
      );
    }

    // Delete rejected entry — themed confirm
    function deleteRejected(certId) {
      showConfirm(
        'This rejected entry will be permanently removed from the database. This action cannot be undone.',
        () => {
          const f = document.getElementById('aa-action-form');
          f.action = '/certificates/delete-rejected/' + certId;
          f.submit();
        },
        { title: 'Delete Rejected Certificate?', type: 'danger', okLabel: 'Delete' }
      );
    }

    // Batch approval handling
    document.addEventListener('DOMContentLoaded', () => {
      const selectAllPending = document.getElementById('select-all-pending');
      const pendingCheckboxes = document.querySelectorAll('.pending-checkbox');
      const btnBulkApprove = document.getElementById('btn-bulk-approve');
      const bulkSelectCount = document.getElementById('bulk-select-count');

      if (selectAllPending) {
        selectAllPending.addEventListener('change', () => {
          pendingCheckboxes.forEach(cb => {
            cb.checked = selectAllPending.checked;
          });
          updateBulkApproveButton();
        });
      }

      pendingCheckboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          if (!cb.checked && selectAllPending) {
            selectAllPending.checked = false;
          }
          const allChecked = Array.from(pendingCheckboxes).every(c => c.checked);
          if (allChecked && selectAllPending) {
            selectAllPending.checked = true;
          }
          updateBulkApproveButton();
        });
      });

      function updateBulkApproveButton() {
        const checkedCount = Array.from(pendingCheckboxes).filter(c => c.checked).length;
        if (checkedCount > 0) {
          btnBulkApprove.style.display = 'inline-flex';
          bulkSelectCount.textContent = checkedCount;
        } else {
          btnBulkApprove.style.display = 'none';
          bulkSelectCount.textContent = '0';
        }
      }

      if (btnBulkApprove) {
        btnBulkApprove.addEventListener('click', async () => {
          const checkedBoxes = Array.from(pendingCheckboxes).filter(c => c.checked);
          const ids = checkedBoxes.map(c => c.value);

          if (ids.length === 0) return;

          showConfirm(
            `Approve and grant certificates for all ${ids.length} selected employee(s)? This will generate certificate numbers immediately.`,
            async () => {
              btnBulkApprove.disabled = true;
              btnBulkApprove.textContent = 'Processing...';
              try {
                const response = await fetch('/aa/certificates/approve-batch', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ ids })
                });
                const result = await response.json();
                if (result.success) {
                  window.location.href = `/aa?success=${encodeURIComponent(result.message)}`;
                } else {
                  showAlert(result.error || 'Failed to approve selected certificates.', 'danger');
                  btnBulkApprove.disabled = false;
                  updateBulkApproveButton();
                }
              } catch (err) {
                console.error('Batch approval error:', err);
                showAlert('An error occurred during batch approval.', 'danger');
                btnBulkApprove.disabled = false;
                updateBulkApproveButton();
              }
            },
            { title: 'Grant / Approve Certificates?', type: 'success', okLabel: 'Grant & Approve' }
          );
        });
      }
    });

    function toggleAll(source) {
      const checkboxes = document.querySelectorAll('.cert-checkbox');
      checkboxes.forEach(cb => {
        const row = cb.closest('tr');
        if (row && row.style.display !== 'none') {
          cb.checked = source.checked;
        }
      });
    }

    function downloadSelectedBatch() {
      const checked = Array.from(document.querySelectorAll('.cert-checkbox:checked'));
      if (checked.length === 0) {
        showConfirm('No certificates selected.', null, { title: 'No Selection', type: 'danger', okLabel: 'OK', hideCancel: true });
        return;
      }
      const params = checked.map(cb => 'ids=' + encodeURIComponent(cb.value)).join('&');
      window.open('/certificate/print-batch?' + params, '_blank');
    }

    function validatePrintForm(event) {
      const checked = Array.from(document.querySelectorAll('.cert-checkbox:checked'));
      if (checked.length === 0) {
        event.preventDefault();
        showConfirm('No certificates selected.', null, { title: 'No Selection', type: 'danger', okLabel: 'OK', hideCancel: true });
        return false;
      }
      return true;
    }

    function applyFilters() {
      const nameInput = document.getElementById('filter-name').value.toLowerCase().trim();
      const dateFromVal = document.getElementById('filter-date-from').value;
      const statusVal = document.getElementById('filter-status').value;

      const rows = document.querySelectorAll('.cert-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const dateStr = row.getAttribute('data-date') || '';
        const status = row.getAttribute('data-status') || '';

        let matchName = true;
        let matchDate = true;
        let matchStatus = true;

        if (nameInput) {
          matchName = name.includes(nameInput);
        }

        if (dateFromVal) {
          matchDate = dateStr >= dateFromVal;
        }

        if (statusVal) {
          matchStatus = status === statusVal;
        }

        if (matchName && matchDate && matchStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Handle custom no-matching-records visual row
      const noRecordsRow = document.getElementById('no-filtered-records-row');
      if (rows.length > 0) {
        if (visibleCount === 0) {
          if (!noRecordsRow) {
            const tbody = document.querySelector('table tbody');
            const tr = document.createElement('tr');
            tr.id = 'no-filtered-records-row';
            tr.innerHTML = `
              <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 2rem;">
                No matching certificate records found for the applied filters.
              </td>
            `;
            tbody.appendChild(tr);
          } else {
            noRecordsRow.style.display = '';
          }
        } else {
          if (noRecordsRow) {
            noRecordsRow.style.display = 'none';
          }
        }
      }
    }

    function resetAllFilters() {
      document.getElementById('filter-name').value = '';
      document.getElementById('filter-date-from').value = '';
      document.getElementById('filter-status').value = '';
      applyFilters();
    }

    function downloadApprovedCSV() {
      const btn = document.getElementById('download-approved-btn');
      if (!btn) return;
      const approvedCerts = JSON.parse(btn.getAttribute('data-certs') || '[]');
      if (approvedCerts.length === 0) {
        showAlert('No approved certificates found to download.', 'danger');
        return;
      }
      
      let csvContent = 'Certificate Number,Crew ID / Employee ID,Employee Name,Designation,Certified Date,Validity Expiry Date,Status\r\n';
      
      approvedCerts.forEach(h => {
        const cDate = new Date(h.certified_date);
        const vDate = new Date(h.valid_upto);
        const cDateStr = `${String(cDate.getDate()).padStart(2, '0')}-${String(cDate.getMonth() + 1).padStart(2, '0')}-${cDate.getFullYear()}`;
        const vDateStr = `${String(vDate.getDate()).padStart(2, '0')}-${String(vDate.getMonth() + 1).padStart(2, '0')}-${vDate.getFullYear()}`;
        
        const certNo = h.cert_number || 'N/A';
        const empId = h.employee_id || '';
        const empName = `"${(h.employee_name || '').replace(/"/g, '""')}"`;
        const designation = `"${(h.designation || '').replace(/"/g, '""')}"`;
        const status = h.status || '';
        
        csvContent += `${certNo},${empId},${empName},${designation},${cDateStr},${vDateStr},${status}\r\n`;
      });
      
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `approved_certificates_${new Date().toISOString().split('T')[0]}.csv`);
      link.style.visibility = 'hidden';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // ========================================================
    // LIVE AUTO-POLL — updates pending + history without reload
    // ========================================================
    (function startLivePolling() {
      const POLL_INTERVAL_MS = 5000; // 5 seconds
      let pollTimer = null;
      let lastPendingCount = document.querySelectorAll('#select-all-pending ~ * .pending-checkbox, .pending-checkbox').length;

      async function poll() {
        try {
          const res = await fetch('/api/poll/aa');
          if (!res.ok) return;
          const data = await res.json();
          if (!data.ok) return;

          const newPendingCount = data.pendingCount;

          // --- Pending section: if count changed, reload page (avoids complex DOM surgery for approve/reject UI) ---
          if (newPendingCount !== lastPendingCount) {
            lastPendingCount = newPendingCount;
            const diff = newPendingCount - (lastPendingCount === newPendingCount ? newPendingCount : lastPendingCount);
            // New pending cert arrived — notify FA (notify sound + toast)
            if (data.pendingCount > document.querySelectorAll('.pending-checkbox').length) {
              showAlert('🔔 A new certificate request has arrived for approval!', 'success');
            }
            // Silently reload after a short delay so the user sees the toast first
            setTimeout(() => window.location.reload(), 1500);
            return;
          }

          // --- History table: update status changes in-place ---
          data.history.forEach(cert => {
            const row = document.querySelector(`tr[data-cert-id-hist="${cert.id}"]`);
            if (!row) return;

            const currentStatus = row.getAttribute('data-status');
            if (currentStatus === cert.status) return;

            row.setAttribute('data-status', cert.status);

            // Flash highlight
            row.style.transition = 'background 0.3s ease';
            row.style.background = 'rgba(99,102,241,0.12)';
            setTimeout(() => { row.style.background = ''; }, 2000);
          });

          // Update certified badge count
          const approvedCount = data.history.filter(c => c.status === 'APPROVED').length;
          const goalNumber = document.querySelector('.goal-number');
          if (goalNumber) goalNumber.textContent = approvedCount;

        } catch (e) {
          // Silently ignore
        }

        pollTimer = setTimeout(poll, POLL_INTERVAL_MS);
      }

      pollTimer = setTimeout(poll, POLL_INTERVAL_MS);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          clearTimeout(pollTimer);
        } else {
          pollTimer = setTimeout(poll, 500);
        }
      });
    })();
  </script>
  <style>
    @keyframes livePulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.88) translateY(12px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
  </style>
</body>

</html>